{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Light Static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "5174", "completa"],
      "port": 5174
    },
    {
      "name": "Backend Server",
      "runtimeExecutable": "node",
