{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "vue-dev",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev", "--prefix", "inventario-vue"],
            "port": 5173
        },
        {
            "name": "vue-dev-local-api",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev:local", "--prefix", "inventario-vue", "--", "--port", "5199"],
            "port": 5199,
            "autoPort": false
        },
        {
            "name": "light-static",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["-y", "http-server", "light", "-p", "8099", "-c-1"],
            "port": 8099
        },
        {
            "name": "backend-local",
            "runtimeExecutable": "node",
            "runtimeArgs": ["server.js"],
            "port": 3000
        }
    ]
}
